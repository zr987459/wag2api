diff --git a/internal/sqlitedb/sqlitedb_purego.go b/internal/sqlitedb/sqlitedb_purego.go
new file mode 100644
index 0000000..9c2d05b
--- /dev/null
+++ b/internal/sqlitedb/sqlitedb_purego.go
@@ -0,0 +1,67 @@
+//go:build !cgo
+
+// Package sqlitedb 以原生 SQLite 打开服务的本地数据库
+package sqlitedb
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"path/filepath"
+
+	"net/url"
+
+	_ "modernc.org/sqlite"
+)
+
+const incrementalVacuum = 2
+
+// dsnPragmas 是纯 Go 驱动每个新连接按顺序执行的设置，增量收缩须在启用 WAL 之前
+var dsnPragmas = []string{"auto_vacuum(INCREMENTAL)", "busy_timeout(10000)", "journal_mode(WAL)", "synchronous(NORMAL)", "journal_size_limit(524288)"}
+
+// Open 打开或创建数据库，非增量收缩的已有库先整理为增量收缩，再交还空闲页
+func Open(path string) (*sql.DB, error) {
+	db, err := sql.Open("sqlite", pureDSN(path))
+	if err != nil {
+		return nil, err
+	}
+	var mode int
+	if err := db.QueryRow(`PRAGMA auto_vacuum`).Scan(&mode); err != nil {
+		return nil, errors.Join(fmt.Errorf("读取收缩模式: %w", err), db.Close())
+	}
+	if mode != incrementalVacuum {
+		if _, err := db.Exec(`VACUUM`); err != nil {
+			return nil, errors.Join(fmt.Errorf("整理数据库: %w", err), db.Close())
+		}
+	}
+	if err := Reclaim(context.Background(), db); err != nil {
+		return nil, errors.Join(err, db.Close())
+	}
+	return db, nil
+}
+
+// Reclaim 把空闲页交还文件系统并截短 WAL 文件，incremental_vacuum 每交还一页返回一行，读完全部行才交还全部空闲页
+func Reclaim(ctx context.Context, db *sql.DB) error {
+	rows, err := db.QueryContext(ctx, `PRAGMA incremental_vacuum`)
+	if err != nil {
+		return fmt.Errorf("交还空闲页: %w", err)
+	}
+	for rows.Next() {
+	}
+	if err := rows.Err(); err != nil {
+		return fmt.Errorf("交还空闲页: %w", err)
+	}
+	if _, err := db.ExecContext(ctx, `PRAGMA wal_checkpoint(TRUNCATE)`); err != nil {
+		return fmt.Errorf("截短 WAL: %w", err)
+	}
+	return nil
+}
+
+func pureDSN(path string) string {
+	q := url.Values{}
+	for _, p := range dsnPragmas {
+		q.Add("_pragma", p)
+	}
+	return "file:" + filepath.ToSlash(path) + "?" + q.Encode()
+}
