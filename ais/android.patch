new file mode 100644
index 0000000..aa3bd99
--- /dev/null
+++ b/internal/app/update_wag2api.go
@@ -0,0 +1,37 @@
+//go:build !desktop && wag2api
+
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"sync/atomic"
+)
+
+// wag2api 安卓精简版：二进制随 APK 更新（nativeLibraryDir 只读），不带 selfupdate
+func init() {
+	if managedBy == "" {
+		managedBy = "wag2api"
+	}
+}
+
+func platformUpdateMode() string {
+	return "managed"
+}
+
+func (u *selfUpdater) install(context.Context, *githubRelease) error {
+	return errors.New("在线更新由 wag2api 管理")
+}
+
+func updateRestart(stop func(), restarting *atomic.Bool, _ func(level, message string)) func() {
+	return func() {
+		restarting.Store(true)
+		stop()
+	}
+}
+
+func releasePackage(tag string) (string, string) {
+	return fmt.Sprintf("aistudio2api-%s-%s-%s", tag, runtime.GOOS, runtime.GOARCH) + ".tar.gz", "aistudio2api"
+}
