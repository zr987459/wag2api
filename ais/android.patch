+//go:build wag2api
+
+package api
+
+import "fmt"
+
+// wag2api 安卓精简版不带 AAC / Opus / FLAC 编码器（gopus 等约占 3MB），
+// 语音输出请用 mp3（默认）、wav、pcm、alaw 或 mulaw。
+
+func errAudioFormat(format string) error {
+	return fmt.Errorf("audio format %q is not available in this build (wag2api android); use mp3, wav, pcm, alaw or mulaw", format)
+}
+
+func encodeAAC(audioPCM, int) ([]byte, error) { return nil, errAudioFormat("aac") }
+
+func encodeOggOpus(audioPCM, int) ([]byte, error) { return nil, errAudioFormat("opus") }
+
+func encodeFLAC(audioPCM) ([]byte, error) { return nil, errAudioFormat("flac") }
