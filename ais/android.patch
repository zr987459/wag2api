diff --git a/internal/webui/embed_wag2api.go b/internal/webui/embed_wag2api.go
new file mode 100644
index 0000000..607b793
--- /dev/null
+++ b/internal/webui/embed_wag2api.go
@@ -0,0 +1,37 @@
+//go:build wag2api
+
+// Package webui 提供内嵌管理端静态资源；wag2api 安卓精简版不内嵌 Web UI（由 wag2api 自己的控制台管理）
+package webui
+
+import (
+	"net/http"
+	"path"
+	"strings"
+)
+
+const headlessPage = `<!doctype html><meta charset="utf-8"><title>AIStudio2API</title><p>AIStudio2API (wag2api headless build). Manage it from the wag2api console.</p>`
+
+// Handler 在非 API 路径上返回一个极简说明页
+func Handler() http.Handler {
+	return http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		if reservedPath(path.Clean(request.URL.Path)) || (request.Method != http.MethodGet && request.Method != http.MethodHead) {
+			http.NotFound(writer, request)
+			return
+		}
+		writer.Header().Set("Content-Type", "text/html; charset=utf-8")
+		writer.WriteHeader(http.StatusOK)
+		if request.Method == http.MethodGet {
+			_, _ = writer.Write([]byte(headlessPage))
+		}
+	})
+}
+
+// reservedPath 判断路径是否属于服务 API
+func reservedPath(requestPath string) bool {
+	for _, prefix := range []string{"/api", "/v1", "/v1beta", "/health"} {
+		if requestPath == prefix || strings.HasPrefix(requestPath, prefix+"/") {
+			return true
+		}
+	}
+	return false
+}
