@@ -0,0 +1,22 @@
+//go:build wag2api
+
+package api
+
+import (
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/aistudio"
+)
+
+// wag2api 安卓精简版不带 MCP 客户端（go-sdk/mcp + jsonschema 等约 1MB）。
+// 普通 mcp 工具照常交给 AI Studio 服务端调用；只有需要本地 tools/list 过滤（只读 / 排除工具）的服务器会报错。
+func (s *server) resolveMCPTools(_ context.Context, request aistudio.GenerateRequest) (aistudio.GenerateRequest, error) {
+	if slices.ContainsFunc(request.Tools.MCPServers, func(server aistudio.MCPServer) bool {
+		return server.ReadOnly || len(server.DisabledTools) > 0
+	}) {
+		return request, errors.New("mcp read-only / disabled-tools filtering is not available in this build (wag2api android)")
+	}
+	return request, nil
+}
