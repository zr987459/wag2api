+++ b/cmd/aistudio2api/dns_fallback.go
@@ -0,0 +1,44 @@
+//go:build linux || android
+
+package main
+
+import (
+	"context"
+	"net"
+	"os"
+	"strings"
+	"time"
+)
+
+// 安卓没有 /etc/resolv.conf，纯 Go 解析器默认问 127.0.0.1:53 会失败；
+// 此时优先使用宿主传入的 AIS_DNS（逗号分隔），否则直连公共 DNS
+func init() {
+	if _, err := os.Stat("/etc/resolv.conf"); err == nil {
+		return
+	}
+	var servers []string
+	for _, s := range strings.Split(os.Getenv("AIS_DNS"), ",") {
+		if s = strings.TrimSpace(s); s != "" {
+			if _, _, err := net.SplitHostPort(s); err != nil {
+				s = net.JoinHostPort(s, "53")
+			}
+			servers = append(servers, s)
+		}
+	}
+	servers = append(servers, "223.5.5.5:53", "1.1.1.1:53", "8.8.8.8:53")
+	net.DefaultResolver = &net.Resolver{
+		PreferGo: true,
+		Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			d := net.Dialer{Timeout: 3 * time.Second}
+			var last error
+			for _, s := range servers {
+				c, err := d.DialContext(ctx, network, s)
+				if err == nil {
+					return c, nil
+				}
+				last = err
+			}
+			return nil, last
+		},
+	}
+}
